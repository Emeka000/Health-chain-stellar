# Health-chain backend environment example
# Copy this file to .env and configure values before running the backend.

# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
# APP_NAME is the human-readable service name used in logs, emails and API metadata.
# Optional. Default: Health Chain
APP_NAME=Health Chain
# APP_URL is the backend's own public base URL (used for links/callbacks).
# Optional. Default: http://localhost:3001
APP_URL=http://localhost:3001
# FRONTEND_URL is the public base URL of the frontend, used when building links
# in emails/notifications. Optional. Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Required. CORS_ORIGIN lists the FRONTEND's origin(s) allowed to call this API — not the backend's own
# port. The backend listens on PORT (3001 by default); the Next.js frontend stays on :3000.
# Comma-separated values are supported for multiple allowed origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:4200
TRUST_PROXY=false

# Database
# IMPORTANT: Use only DATABASE_* keys (not DB_* variants).
# The env schema validates DATABASE_* and TypeOrmModule reads these keys.
# Using incorrect keys will result in validation failure or connection mismatch.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=health_chain

# JWT / auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_SECRET_KID=key-1
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_SECRET_KID=key-0
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Cursors
# CURSOR_SECRET signs pagination cursors so clients cannot forge or tamper with them.
# Required in production. Generate with: openssl rand -hex 32
CURSOR_SECRET=your-cursor-signing-secret-change-in-production

# QR codes
# QR_HMAC_SECRET is the HMAC key used to sign anti-replay QR codes.
# Required in production. Generate with: openssl rand -hex 32
QR_HMAC_SECRET=your-qr-hmac-secret-change-in-production

# Delivery proofs
# DELIVERY_PROOF_SIGNER_KID identifies the active delivery-proof signing key.
# Required when delivery-proof verification is enabled. Default: key-1
DELIVERY_PROOF_SIGNER_KID=key-1
# DELIVERY_PROOF_SIGNER_PUBLIC_KEY is the public key (hex/base64) for the active signer.
# Required when delivery-proof verification is enabled.
DELIVERY_PROOF_SIGNER_PUBLIC_KEY=
# DELIVERY_PROOF_PREVIOUS_SIGNER_KID / _PUBLIC_KEY support key rotation: set these to the
# previous signer so in-flight proofs signed with the old key still verify. Optional.
DELIVERY_PROOF_PREVIOUS_SIGNER_KID=
DELIVERY_PROOF_PREVIOUS_SIGNER_PUBLIC_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL is an alternative to the REDIS_HOST/PORT/PASSWORD trio (e.g. redis://:pass@host:6379/0).
# Optional. If set, it takes precedence over the individual REDIS_* keys.
REDIS_URL=
# RUN_REDIS_THROTTLE_TESTS enables the Redis-backed throttler integration tests.
# Optional. Default: false
RUN_REDIS_THROTTLE_TESTS=false

# Maps
MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Soroban Blockchain
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_SECRET_KEY=your-soroban-secret-key
SOROBAN_NETWORK=testnet
SOROBAN_CONFIRMATION_DEPTH=1
EXPECTED_CONTRACT_VERSION=1

# Per-contract addresses (populated by scripts/generate-bindings.sh after deployment).
# All 10 contracts: coordinator, identity, inventory, payments, requests, temperature, matching, reputation, delivery, analytics.
# These take precedence over the addresses in lifebank-soroban/contracts.json.
# Leave blank to fall back to contracts.json for the active SOROBAN_NETWORK.
SOROBAN_COORDINATOR_CONTRACT_ID=
SOROBAN_IDENTITY_CONTRACT_ID=
SOROBAN_INVENTORY_CONTRACT_ID=
SOROBAN_PAYMENTS_CONTRACT_ID=
SOROBAN_REQUESTS_CONTRACT_ID=
SOROBAN_TEMPERATURE_CONTRACT_ID=
SOROBAN_MATCHING_CONTRACT_ID=
SOROBAN_REPUTATION_CONTRACT_ID=
SOROBAN_DELIVERY_CONTRACT_ID=
SOROBAN_ANALYTICS_CONTRACT_ID=
# SOROBAN_ORG_REGISTRY_CONTRACT_ID is the on-chain organization registry contract used for
# org registration/verification. Required for on-chain org registration. Leave blank to disable.
SOROBAN_ORG_REGISTRY_CONTRACT_ID=

# Legacy single-contract ID (kept for backward compatibility — prefer the per-contract vars above).
SOROBAN_CONTRACT_ID=

# Blockchain callbacks
BLOCKCHAIN_CALLBACK_SECRET=your-blockchain-callback-secret
ADMIN_KEY=your-admin-key

# Africa's Talking (SMS)
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox

# Firebase (Push Notifications)
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Account & session limits
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_HISTORY_LENGTH=3
REQUIRE_EMAIL_VERIFICATION=false
MAX_CONCURRENT_SESSIONS=5
MAX_CONCURRENT_SESSIONS_DONOR=3
MAX_CONCURRENT_SESSIONS_HOSPITAL=5
MAX_CONCURRENT_SESSIONS_ADMIN=2

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10
THROTTLER_USE_REDIS=true

# Inventory Forecasting
INVENTORY_FORECAST_CRON=0 */6 * * *
INVENTORY_FORECAST_THRESHOLD_DAYS=3
INVENTORY_FORECAST_HISTORY_DAYS=30

# Data Retention
RETENTION_JOB_CRON=0 2 * * *
RETENTION_SESSION_TTL_DAYS=30
RETENTION_ACTIVITY_LOG_DAYS=90

# Storage
# STORAGE_PATH is the base directory for locally stored files. Optional. Default: ./uploads
STORAGE_PATH=./uploads
# UPLOAD_DIR is the directory uploads are written to (falls back to STORAGE_PATH when unset).
# Optional. Default: ./uploads
UPLOAD_DIR=./uploads
# MEDIA_STORAGE_PATH is the directory for media (images/attachments) storage.
# Optional. Default: ./uploads/media
MEDIA_STORAGE_PATH=./uploads/media
# S3_BUCKET is the bucket used when storing files in S3. Required only when using S3 storage.
S3_BUCKET=
# AWS_REGION is the AWS region for the S3 bucket. Required only when using S3 storage.
AWS_REGION=
# AWS_ENDPOINT overrides the S3 endpoint (e.g. for MinIO/LocalStack). Optional.
AWS_ENDPOINT=
